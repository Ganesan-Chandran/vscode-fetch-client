{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Fetch Client Test Cases",
	"description": "Test case file (version 1.x) generated from the AI Prompt tab and imported in the Test panel.",
	"type": "object",
	"required": ["schema", "version", "requests"],
	"additionalProperties": false,
	"properties": {
		"schema": { "const": "fetch-client-testcases" },
		"version": { "type": "string", "pattern": "^1(\\.\\d+)*$" },
		"requests": {
			"type": "array",
			"minItems": 1,
			"items": { "$ref": "#/definitions/request" }
		},
		"extensions": { "type": "object" }
	},
	"definitions": {
		"request": {
			"type": "object",
			"required": ["method", "url", "testCases"],
			"additionalProperties": false,
			"properties": {
				"id": { "type": "string" },
				"name": { "type": "string" },
				"method": { "type": "string", "minLength": 1 },
				"url": { "type": "string", "minLength": 1 },
				"testCases": {
					"type": "array",
					"minItems": 1,
					"items": { "$ref": "#/definitions/testCase" }
				},
				"extensions": { "type": "object" }
			}
		},
		"testCase": {
			"type": "object",
			"required": ["name", "assertions"],
			"additionalProperties": false,
			"properties": {
				"name": { "type": "string", "minLength": 1 },
				"description": { "type": "string" },
				"category": { "type": "string" },
				"assertions": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "object",
						"required": ["type"],
						"properties": {
							"type": {
								"enum": [
									"statusCode",
									"responseTime",
									"body",
									"header",
									"jsonPath"
								]
							}
						},
						"allOf": [
							{
								"if": { "properties": { "type": { "const": "statusCode" } } },
								"then": { "$ref": "#/definitions/statusCodeAssertion" }
							},
							{
								"if": { "properties": { "type": { "const": "responseTime" } } },
								"then": { "$ref": "#/definitions/responseTimeAssertion" }
							},
							{
								"if": { "properties": { "type": { "const": "body" } } },
								"then": { "$ref": "#/definitions/bodyAssertion" }
							},
							{
								"if": { "properties": { "type": { "const": "header" } } },
								"then": { "$ref": "#/definitions/headerAssertion" }
							},
							{
								"if": { "properties": { "type": { "const": "jsonPath" } } },
								"then": { "$ref": "#/definitions/jsonPathAssertion" }
							}
						]
					}
				},
				"extensions": { "type": "object" }
			}
		},
		"expected": {
			"type": ["string", "number", "boolean", "null"]
		},
		"statusCodeAssertion": {
			"type": "object",
			"required": ["type", "operator", "expected"],
			"additionalProperties": false,
			"properties": {
				"type": { "const": "statusCode" },
				"operator": {
					"enum": ["equal", "notEqual", "<", "<=", ">", ">=", "regex"]
				},
				"expected": { "$ref": "#/definitions/expected" }
			}
		},
		"responseTimeAssertion": {
			"type": "object",
			"required": ["type", "operator", "expected"],
			"additionalProperties": false,
			"properties": {
				"type": { "const": "responseTime" },
				"operator": {
					"enum": ["equal", "notEqual", "<", "<=", ">", ">="]
				},
				"expected": { "$ref": "#/definitions/expected" }
			}
		},
		"bodyAssertion": {
			"type": "object",
			"required": ["type", "operator"],
			"additionalProperties": false,
			"properties": {
				"type": { "const": "body" },
				"operator": {
					"enum": ["isJSON", "equal", "notEqual", "contains", "regex"]
				},
				"expected": { "$ref": "#/definitions/expected" }
			}
		},
		"headerAssertion": {
			"type": "object",
			"required": ["type", "name", "operator", "expected"],
			"additionalProperties": false,
			"properties": {
				"type": { "const": "header" },
				"name": { "type": "string", "minLength": 1 },
				"operator": {
					"enum": ["equal", "notEqual", "contains", "type", "regex"]
				},
				"expected": { "$ref": "#/definitions/expected" }
			}
		},
		"jsonPathAssertion": {
			"type": "object",
			"required": ["type", "path", "operator", "expected"],
			"additionalProperties": false,
			"properties": {
				"type": { "const": "jsonPath" },
				"path": { "type": "string", "minLength": 1 },
				"operator": {
					"enum": [
						"equal",
						"notEqual",
						"<",
						"<=",
						">",
						">=",
						"contains",
						"notContains",
						"length",
						"type",
						"regex"
					]
				},
				"expected": { "$ref": "#/definitions/expected" }
			}
		}
	}
}
